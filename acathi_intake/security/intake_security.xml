<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_acathi_intake" model="ir.module.category">
        <field name="name">Acogida ACATHI</field>
        <field name="sequence">21</field>
    </record>
    <!-- Categoría propia para el acceso a datos sensibles: así se asigna como
         casilla independiente (ortogonal al nivel Usuario/Coordinación). -->
    <record id="module_category_acathi_sensitive" model="ir.module.category">
        <field name="name">Acogida · Datos sensibles</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_acathi_intake_user" model="res.groups">
        <field name="name">Acogida / Usuario</field>
        <field name="category_id" ref="module_category_acathi_intake"/>
        <field name="comment">Gestiona solicitudes de acogida SIN ver el contenido íntimo (mensaje original, resúmenes, cuerpo de los mensajes).</field>
    </record>

    <record id="group_acathi_intake_manager" model="res.groups">
        <field name="name">Acogida / Coordinación</field>
        <field name="category_id" ref="module_category_acathi_intake"/>
        <field name="implied_ids" eval="[(4, ref('group_acathi_intake_user'))]"/>
        <field name="comment">Acceso completo, incluyendo eliminar y configurar.</field>
    </record>

    <record id="group_acathi_sensitive" model="res.groups">
        <field name="name">Acogida / Datos sensibles</field>
        <field name="category_id" ref="module_category_acathi_sensitive"/>
        <field name="implied_ids" eval="[(4, ref('group_acathi_intake_user'))]"/>
        <field name="comment">Además de lo anterior, puede ver el contenido sensible (RGPD, categoría especial art. 9). Asígnese solo al personal que atiende casos: jurídica, social, salud, acogida.</field>
    </record>

    <!-- Regla base: los managers pueden borrar; el resto no.
         Reglas de visibilidad POR EQUIPO (ir.rule sobre 'team') se dejan para Fase 2,
         pendiente de lo que exija la EIPD (ver especificacion_mvp / EIPD §5). -->
</odoo>
