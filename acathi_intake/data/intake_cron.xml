<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Retención RGPD. DESACTIVADO por defecto (active=False).
             Actívese solo cuando la asesoría fije el plazo y se configure el
             parámetro del sistema 'acathi_intake.retention_days' (> 0). -->
        <record id="ir_cron_intake_retention" model="ir.cron">
            <field name="name">ACATHI Acogida: retención (purga de contenido)</field>
            <field name="model_id" ref="model_acathi_intake_request"/>
            <field name="state">code</field>
            <field name="code">model._gc_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
