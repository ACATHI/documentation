<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ VISTA LLISTA ══════════════════════════════════════════════════════ -->
    <record id="view_acathi_pcl5_tree" model="ir.ui.view">
        <field name="name">acathi.pcl5.tree</field>
        <field name="model">acathi.pcl5</field>
        <field name="arch" type="xml">
            <tree string="PCL-5 TEPT"
                  decoration-danger="score >= 50"
                  decoration-warning="score >= 31 and score &lt; 50">
                <field name="date"/>
                <field name="person_id"/>
                <field name="case_id"/>
                <field name="professional_id"/>
                <field name="trauma_event" string="Esdeveniment"/>
                <field name="score" string="Puntuació"/>
                <field name="severity" string="Nivell"/>
            </tree>
        </field>
    </record>

    <!-- ══ VISTA FORMULARI ═══════════════════════════════════════════════════ -->
    <record id="view_acathi_pcl5_form" model="ir.ui.view">
        <field name="name">acathi.pcl5.form</field>
        <field name="model">acathi.pcl5</field>
        <field name="arch" type="xml">
            <form string="PCL-5 — Llista de Verificació del TEPT (DSM-5)">
                <sheet>
                    <group string="Informació general">
                        <group>
                            <field name="person_id"/>
                            <field name="case_id"/>
                        </group>
                        <group>
                            <field name="professional_id"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <group>
                        <field name="trauma_event" placeholder="Descriviu breument l'esdeveniment de referència"/>
                    </group>

                    <separator string="Instruccions"/>
                    <div class="alert alert-info" role="alert">
                        <p>Per a cada reacció de la llista, indiqueu en quina mesura us heu
                        sentit molest/a a causa de l'experiència traumàtica de referència
                        durant el <strong>darrer mes</strong>.
                        Escala: 0 = Gens · 1 = Una mica · 2 = Moderadament
                        · 3 = Bastant · 4 = Extremament.</p>
                    </div>

                    <separator string="Ítems 1–10"/>
                    <group col="1">
                        <field name="q1" widget="radio" options="{'horizontal': true}"/>
                        <field name="q2" widget="radio" options="{'horizontal': true}"/>
                        <field name="q3" widget="radio" options="{'horizontal': true}"/>
                        <field name="q4" widget="radio" options="{'horizontal': true}"/>
                        <field name="q5" widget="radio" options="{'horizontal': true}"/>
                        <field name="q6" widget="radio" options="{'horizontal': true}"/>
                        <field name="q7" widget="radio" options="{'horizontal': true}"/>
                        <field name="q8" widget="radio" options="{'horizontal': true}"/>
                        <field name="q9" widget="radio" options="{'horizontal': true}"/>
                        <field name="q10" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <separator string="Ítems 11–20"/>
                    <group col="1">
                        <field name="q11" widget="radio" options="{'horizontal': true}"/>
                        <field name="q12" widget="radio" options="{'horizontal': true}"/>
                        <field name="q13" widget="radio" options="{'horizontal': true}"/>
                        <field name="q14" widget="radio" options="{'horizontal': true}"/>
                        <field name="q15" widget="radio" options="{'horizontal': true}"/>
                        <field name="q16" widget="radio" options="{'horizontal': true}"/>
                        <field name="q17" widget="radio" options="{'horizontal': true}"/>
                        <field name="q18" widget="radio" options="{'horizontal': true}"/>
                        <field name="q19" widget="radio" options="{'horizontal': true}"/>
                        <field name="q20" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <separator string="Resultats"/>
                    <group>
                        <group>
                            <field name="score" readonly="1"/>
                        </group>
                        <group>
                            <field name="severity" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Observacions"/>
                    <field name="notes" placeholder="Observacions addicionals del professional..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══ VISTA CERCA ═══════════════════════════════════════════════════════ -->
    <record id="view_acathi_pcl5_search" model="ir.ui.view">
        <field name="name">acathi.pcl5.search</field>
        <field name="model">acathi.pcl5</field>
        <field name="arch" type="xml">
            <search string="Cercar PCL-5">
                <field name="person_id" string="Persona"/>
                <field name="professional_id" string="Professional"/>
                <field name="date" string="Data"/>
                <field name="trauma_event" string="Esdeveniment"/>
                <filter string="Any actual" name="filter_this_year"
                        domain="[('date', '>=', (context_today()).strftime('%Y') + '-01-01'),
                                  ('date', '&lt;=', (context_today()).strftime('%Y') + '-12-31')]"/>
                <separator/>
                <filter string="Llindar TEPT o superior" name="filter_threshold"
                        domain="[('score', '>=', 31)]"/>
                <group expand="0" string="Agrupar per">
                    <filter string="Persona" name="group_person" context="{'group_by': 'person_id'}"/>
                    <filter string="Professional" name="group_professional" context="{'group_by': 'professional_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══ ACCIÓ ══════════════════════════════════════════════════════════════ -->
    <record id="action_acathi_pcl5" model="ir.actions.act_window">
        <field name="name">PCL-5 TEPT</field>
        <field name="res_model">acathi.pcl5</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_acathi_pcl5_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registreu una nova avaluació PCL-5
            </p>
        </field>
    </record>

</odoo>
