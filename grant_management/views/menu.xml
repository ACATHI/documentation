              web_icon="grant_management,static/description/icon.png"/>

    <!-- Expedients -->
    <menuitem id="menu_grant_applications"
              name="Expedients"
              parent="menu_grant_root"
              action="action_grant_application"
              sequence="10"/>

    <!-- Projectes socials base -->
    <menuitem id="menu_grant_projects"
              name="Projectes socials"
              parent="menu_grant_root"
