<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_generate_document_wizard_form" model="ir.ui.view">
    <field name="name">acathi.generate.document.wizard.form</field>
    <field name="model">acathi.generate.document.wizard</field>
    <field name="arch" type="xml">
      <form string="Generar document">
        <sheet>
          <field name="state" invisible="1"/>
          <!-- Configuració -->
          <group invisible="state == 'done'">
            <group string="Configuració">
              <field name="template_type"/>
              <field name="template_id" options="{'no_create': True}"/>
            </group>
            <group string="Dades">
              <field name="person_id" invisible="template_type != 'certificate'"/>
              <field name="activity_id"/>
              <field name="donation_id" invisible="template_type != 'donation'"/>
            </group>
          </group>

          <!-- Resultat -->
          <group invisible="state != 'done'" string="Document generat">
            <field name="result_file" widget="binary" filename="result_filename"
                   string="Descarregar"/>
            <field name="result_filename" invisible="1"/>
          </group>
        </sheet>
        <footer>
          <button string="Generar" name="action_generate" type="object"
                  class="btn-primary" invisible="state == 'done'"/>
          <button string="Tancar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_generate_document_wizard" model="ir.actions.act_window">
    <field name="name">Generar document</field>
    <field name="res_model">acathi.generate.document.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_acathi_generate_document"
            name="Generar document"
            parent="menu_acathi_documents_root"
            action="action_generate_document_wizard"
            sequence="30"/>

</odoo>
