<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_acathi_donation_list" model="ir.ui.view">
    <field name="name">acathi.donation.list</field>
    <field name="model">acathi.donation</field>
    <field name="arch" type="xml">
      <tree string="Donacions"
            decoration-success="state == 'receipt_sent'"
            decoration-warning="state == 'confirmed'"
            decoration-muted="state == 'draft'">
        <field name="date_received"/>
        <field name="donor_id"/>
        <field name="donor_type" widget="badge"
               decoration-info="donor_type == 'individual'"
               decoration-warning="donor_type == 'company'"/>
        <field name="amount" sum="Total"/>
        <field name="purpose"/>
        <field name="state" widget="badge"
               decoration-success="state == 'receipt_sent'"
               decoration-warning="state == 'confirmed'"
               decoration-muted="state == 'draft'"/>
      </tree>
    </field>
  </record>

  <record id="view_acathi_donation_form" model="ir.ui.view">
    <field name="name">acathi.donation.form</field>
    <field name="model">acathi.donation</field>
    <field name="arch" type="xml">
      <form string="Donació">
        <header>
          <button string="Confirmar" name="action_confirm" type="object"
                  invisible="state != 'draft'" class="btn-primary"/>
          <button string="Marcar rebut enviat" name="action_mark_receipt_sent" type="object"
                  invisible="state != 'confirmed'" class="btn-secondary"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,receipt_sent"/>
        </header>
        <sheet>
          <field name="certificate_attachment_id" invisible="1"/>
          <div class="oe_button_box" name="button_box">
            <button name="action_generate_certificate" type="object"
                    class="oe_stat_button" icon="fa-file-word-o">
              <span class="o_stat_text">Generar certificat</span>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Donant">
              <field name="donor_id" options="{'no_quick_create': True}"/>
              <field name="donor_type" readonly="1"/>
              <field name="donor_email" readonly="1"/>
              <field name="donor_phone" readonly="1"/>
            </group>
            <group string="Donació">
              <field name="amount"/>
              <field name="date_received"/>
            </group>
          </group>
          <group string="Finalitat dels fons">
            <field name="purpose" nolabel="1"
                   placeholder="Descriu a quins fins es destinaran els fons rebuts..."/>
          </group>
          <group string="Notes" invisible="not notes">
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_acathi_donation" model="ir.actions.act_window">
    <field name="name">Donacions</field>
    <field name="res_model">acathi.donation</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_acathi_donations"
            name="Donacions"
            parent="menu_acathi_documents_root"
            action="action_acathi_donation"
            sequence="20"/>

</odoo>
