<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_collab_request_tree" model="ir.ui.view">
        <field name="name">acathi.collab.request.tree</field>
        <field name="model">acathi.collab.request</field>
        <field name="arch" type="xml">
            <tree string="Colaboraciones">
                <field name="name"/>
                <field name="collab_type"/>
                <field name="contact_name"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="team"/>
                <field name="assigned_user_id"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_collab_request_form" model="ir.ui.view">
        <field name="name">acathi.collab.request.form</field>
        <field name="model">acathi.collab.request</field>
        <field name="arch" type="xml">
            <form string="Colaboración">
                <header>
                    <button name="action_mark_contacted" string="Marcar contactada"
                            type="object" class="btn-primary"
                            invisible="state in ('contacted','accepted','closed','cancelled')"/>
                    <button name="action_close" string="Cerrar" type="object"
                            invisible="state in ('closed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_review,contacted,accepted,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Colaboración">
                            <field name="collab_type"/>
                            <field name="team"/>
                            <field name="assigned_user_id"/>
                            <field name="needs_human_review"/>
                            <field name="source_channel"/>
                            <field name="language"/>
                        </group>
                        <group string="Contacto">
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="company_name"
                                   invisible="collab_type != 'empresa'"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="has_whatsapp"/>
                        </group>
                    </group>
                    <group>
                        <group string="Detalles">
                            <field name="area"
                                   invisible="collab_type in ('empresa','evento_benefico')"/>
                            <field name="availability"
                                   invisible="collab_type != 'voluntariado'"/>
                            <field name="study_center"
                                   invisible="collab_type != 'practicas'"/>
                            <field name="event_subtype"
                                   invisible="collab_type != 'evento_benefico'"/>
                            <field name="event_date"
                                   invisible="collab_type != 'evento_benefico'"/>
                            <field name="collaboration_kind"
                                   invisible="collab_type not in ('empresa','evento_benefico')"/>
                        </group>
                        <group string="Consentimiento">
                            <field name="consent_ok"/>
                            <field name="consent_date"/>
                            <field name="consent_text_version"/>
                            <field name="channel_external_id"/>
                        </group>
                    </group>
                    <group string="Mensaje">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_collab_request_search" model="ir.ui.view">
        <field name="name">acathi.collab.request.search</field>
        <field name="model">acathi.collab.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contact_name"/>
                <field name="company_name"/>
                <field name="email"/>
                <filter name="f_voluntariado" string="Voluntariado"
                        domain="[('collab_type','=','voluntariado')]"/>
                <filter name="f_empleo" string="Empleo"
                        domain="[('collab_type','=','empleo')]"/>
                <filter name="f_practicas" string="Prácticas"
                        domain="[('collab_type','=','practicas')]"/>
                <filter name="f_empresa" string="Empresas"
                        domain="[('collab_type','=','empresa')]"/>
                <filter name="f_evento" string="Eventos benéficos"
                        domain="[('collab_type','=','evento_benefico')]"/>
                <separator/>
                <filter name="f_review" string="Requieren revisión"
                        domain="[('needs_human_review','=',True)]"/>
                <filter name="f_open" string="Abiertas"
                        domain="[('state','not in',('closed','cancelled'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_type" string="Tipo"
                            context="{'group_by':'collab_type'}"/>
                    <filter name="g_state" string="Estado"
                            context="{'group_by':'state'}"/>
                    <filter name="g_team" string="Equipo"
                            context="{'group_by':'team'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_collab_request" model="ir.actions.act_window">
        <field name="name">Colaboraciones</field>
        <field name="res_model">acathi.collab.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_collab_request_search"/>
        <field name="context">{'search_default_f_open': 1}</field>
    </record>

    <menuitem id="menu_acathi_collab_root" name="Colaboraciones"
              sequence="22"
              web_icon="acathi_collab,static/description/icon.png"/>
    <menuitem id="menu_acathi_collab_requests" name="Colaboraciones"
              parent="menu_acathi_collab_root"
              action="action_collab_request" sequence="10"/>
</odoo>
